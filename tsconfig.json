{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ES2022",
    "moduleResolution": "bundler", "rootDir": "src", "outDir": "dist",
    "types": ["node"], "declaration": true, "declarationMap": true,
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "tests"]
}
